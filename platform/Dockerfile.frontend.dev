# ─────────────────────────────────────────────────────
# Vite 開発サーバー（HMR 対応）
# Build context: プロジェクトルート（platform/docker-compose.override.yml で context: ..）
# ─────────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

COPY app/frontend/package.json app/frontend/package-lock.json* ./
RUN npm install --no-audit --no-fund

COPY app/frontend/ ./

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
