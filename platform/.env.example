# ─────────────────────────────────────────────────────
# Docker / Laravel 環境変数テンプレート
# `cp .env.example .env` で複製して編集してください
# ─────────────────────────────────────────────────────

# ─── アプリ ──────────────────────────────────────────
APP_NAME="家計バランスシート"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ─── データベース ────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=balance_sheet
DB_USERNAME=bs_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# ─── Sanctum ─────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173
SESSION_DRIVER=cookie
SESSION_DOMAIN=localhost

# ─── ログ ────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug
