{
  "cli": { "version": ">= 7.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost/api" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://staging.example.com/api" }
    },
    "production": {
      "env": { "EXPO_PUBLIC_API_URL": "https://your-domain.example.com/api" }
    }
  },
  "submit": {
    "production": {}
  }
}
