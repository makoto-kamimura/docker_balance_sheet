{
  "expo": {
    "name": "家計バランスシート",
    "slug": "balance-sheet",
    "scheme": "balancesheet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "レシート撮影のためにカメラを使用します。"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.example.balancesheet",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "レシート撮影のためにカメラを使用します。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.balancesheet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "e45c49f6-d692-4b77-bd7d-833ca3c26549"
      }
    }
  }
}
